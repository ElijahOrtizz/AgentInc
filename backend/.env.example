# Agent Ops Backend — Environment Variables
# Copy this file to .env and edit as needed.
# NEVER commit .env to git.

# ── Provider selection ────────────────────────────────────────────────────────
# Which LLM provider to use.
# ollama    = local, free, no API key needed (default)
# anthropic = cloud, paid, requires ANTHROPIC_API_KEY
LLM_PROVIDER=ollama

# ── Ollama settings (used when LLM_PROVIDER=ollama) ─────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# ── Anthropic settings (used when LLM_PROVIDER=anthropic) ───────────────────
# Only required if you set LLM_PROVIDER=anthropic above.
# Get your key from console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
